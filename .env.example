# Copie para .env e preencha. NUNCA commite o .env.
# Variáveis VITE_* ficam visíveis no navegador (a anon key do Supabase é pública por design;
# a segurança vem das políticas RLS no banco).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=

# Usada apenas nas Edge Functions (supabase/functions) — configure em:
#   supabase secrets set ORS_API_KEY=...
# ORS_API_KEY=
