{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": "./src",
    "paths": {
      "assets/*": [
            "assets/*"
      ],
      "components/*": [
            "components/*"
      ],
      "config/*": [
            "config/*"
      ],
      "constants/*": [
            "constants/*"
      ],
      "context/*": [
            "context/*"
      ],
      "hooks/*": [
            "hooks/*"
      ],
      "pages/*": [
            "pages/*"
      ],
      "routes/*": [
            "routes/*"
      ],
      "services/*": [
            "services/*"
      ],
      "styles/*": [
            "styles/*"
      ],
      "utils/*": [
            "utils/*"
      ]
    },
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "build", "dist"]
}
